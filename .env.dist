# ── Integration ──────────────────────────────────────────────────────────────
# Camera snapshot URL (site-specific — no default)
#CAM_SNAPSHOT_URL=http://192.168.178.x:8080/

# Home Assistant (leave empty to disable HA integration)
HA_URL=
HA_TOKEN=

# ── Camera / image geometry ───────────────────────────────────────────────────
ROTATE_DEG=62.5

# Digital strip crop covering all 5 digits: x,y,w,h
DIGITAL_STRIP=654,911,244,50

# Per-digit crop boxes: x,y,w,h per digit, semicolon-separated, D0→D4
DIGITAL_DIGITS=654,911,48,50;702,911,48,50;750,911,48,50;798,911,48,50;846,911,48,50

# Analog dial regions: cx,cy,r per dial, semicolon-separated, A0→A3
ANALOG_DIALS=1038,1067,61;975,1216,61;826,1271,61;676,1203,65

# ── Dial calibration ──────────────────────────────────────────────────────────
# Zero offsets for A0,A1,A2,A3 (degrees, physical properties of this meter)
DIAL_ZERO_OFFSETS=126,270,270,0

# ── Dial influence thresholds ─────────────────────────────────────────────────
# Fraction 0.0–1.0. Boundary correction fires only when both dials confirm it.
DIAL_INFLUENCE_HIGH=0.85
DIAL_INFLUENCE_LOW=0.15

# ── Rollover detection ────────────────────────────────────────────────────────
# corrected_fraction >= this value means the digit drum is transitioning
ROLLOVER_START=0.9

# ── Rate safeguards ───────────────────────────────────────────────────────────
READING_INTERVAL=10
MAX_STEP=0.05
MAX_DELTA_CAP=1.0
JITTER_TOLERANCE=0.010

# ── State ─────────────────────────────────────────────────────────────────────
STATE_FILE=/app/data/.meter_state.json

# Maximum elapsed time for flow rate reporting (seconds). Flow is skipped for
# larger gaps to avoid reporting artificially low rates after outages.
#FLOW_MAX_AGE=300
